<mxfile host="app.diagrams.net" modified="2026-03-24" agent="Claude" version="24.7.17">
  <diagram id="request-flow" name="Request Data Flow">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Request Data Flow: POST /v1/chat/completions" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="35" as="geometry"/>
        </mxCell>

        <!-- ==================== REQUEST PATH (top) ==================== -->
        <mxCell id="req_label" value="REQUEST" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="120" height="30" as="geometry"/>
        </mxCell>

        <!-- 1. Client sends OpenAI format -->
        <mxCell id="r1" value='&lt;b&gt;1. Client Request&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="monospace" size="1"&gt;POST /v1/chat/completions&lt;br&gt;{&lt;br&gt;  "messages": [&lt;br&gt;    {"role": "user",&lt;br&gt;     "content": "Hello"}&lt;br&gt;  ],&lt;br&gt;  "max_tokens": 50,&lt;br&gt;  "temperature": 0.7&lt;br&gt;}&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="230" height="210" as="geometry"/>
        </mxCell>

        <!-- 2. API Gateway passes through -->
        <mxCell id="r2" value="&lt;b&gt;2. API Gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;Routes to Lambda&lt;br&gt;via AWS_PROXY&lt;br&gt;integration&lt;br&gt;&lt;br&gt;Adds CORS headers&lt;br&gt;Passes body as-is" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="200" height="210" as="geometry"/>
        </mxCell>

        <!-- 3. Lambda transforms -->
        <mxCell id="r3" value='&lt;b&gt;3. Lambda (handler.py)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="monospace" size="1"&gt;# messages_to_prompt()&lt;br&gt;prompt = "\n".join(&lt;br&gt;  [m["content"]&lt;br&gt;   for m in messages]&lt;br&gt;)&lt;br&gt;&lt;br&gt;# invoke_sagemaker()&lt;br&gt;payload = {&lt;br&gt;  "inputs": prompt,&lt;br&gt;  "parameters": {&lt;br&gt;    "max_new_tokens": 50,&lt;br&gt;    "temperature": 0.7&lt;br&gt;  }&lt;br&gt;}&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="590" y="110" width="230" height="280" as="geometry"/>
        </mxCell>

        <!-- 4. SageMaker receives -->
        <mxCell id="r4" value='&lt;b&gt;4. SageMaker vLLM&lt;/b&gt;&lt;br&gt;&lt;br&gt;Receives TGI-format&lt;br&gt;payload via&lt;br&gt;InvokeEndpoint&lt;br&gt;&lt;br&gt;&lt;font face="monospace" size="1"&gt;{&lt;br&gt;  "inputs": "Hello",&lt;br&gt;  "parameters": {&lt;br&gt;    "max_new_tokens": 50&lt;br&gt;  }&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;GPU generates tokens' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="880" y="110" width="220" height="280" as="geometry"/>
        </mxCell>

        <!-- Request arrows -->
        <mxCell id="ra12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeWidth=2;strokeColor=#2E7D32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="r1" target="r2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ra23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeWidth=2;strokeColor=#2E7D32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="r2" target="r3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ra34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeWidth=2;strokeColor=#2E7D32;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="r3" target="r4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== RESPONSE PATH (bottom) ==================== -->
        <mxCell id="resp_label" value="RESPONSE" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="120" height="30" as="geometry"/>
        </mxCell>

        <!-- 5. SageMaker returns -->
        <mxCell id="p5" value='&lt;b&gt;5. SageMaker Response&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="monospace" size="1"&gt;[{&lt;br&gt;  "generated_text":&lt;br&gt;    "Hello\nHi there!&lt;br&gt;     How can I help?"&lt;br&gt;}]&lt;/font&gt;&lt;br&gt;&lt;br&gt;(echoes input prompt)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="880" y="460" width="220" height="200" as="geometry"/>
        </mxCell>

        <!-- 6. Lambda strips prompt, formats OpenAI response -->
        <mxCell id="p6" value='&lt;b&gt;6. Lambda Transforms&lt;/b&gt;&lt;br&gt;&lt;br&gt;Strips echoed prompt&lt;br&gt;Wraps in OpenAI format:&lt;br&gt;&lt;br&gt;&lt;font face="monospace" size="1"&gt;{&lt;br&gt;  "id": "chatcmpl-...",&lt;br&gt;  "choices": [{&lt;br&gt;    "message": {&lt;br&gt;      "role": "assistant",&lt;br&gt;      "content":&lt;br&gt;        "Hi there!..."&lt;br&gt;    }&lt;br&gt;  }],&lt;br&gt;  "usage": {...}&lt;br&gt;}&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="590" y="460" width="230" height="300" as="geometry"/>
        </mxCell>

        <!-- 7. Client receives -->
        <mxCell id="p7" value='&lt;b&gt;7. Client Response&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenAI-compatible&lt;br&gt;JSON response&lt;br&gt;&lt;br&gt;Works with any&lt;br&gt;OpenAI SDK client&lt;br&gt;(OpenWebUI, langchain,&lt;br&gt;openai-python, etc.)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="230" height="200" as="geometry"/>
        </mxCell>

        <!-- Response arrows (right to left) -->
        <mxCell id="pa56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeWidth=2;strokeColor=#C62828;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p5" target="p6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;strokeWidth=2;strokeColor=#C62828;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p6" target="p7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Key insight box -->
        <mxCell id="insight" value="&lt;b&gt;Key: Lambda is the translation layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Converts OpenAI chat format (messages array)&lt;br&gt;→ plain text prompt (concatenated with \n)&lt;br&gt;→ SageMaker TGI/vLLM payload format&lt;br&gt;&lt;br&gt;No chat template applied — model receives raw text" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontColor=#E65100;fontSize=12;verticalAlign=middle;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1150" y="460" width="230" height="170" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

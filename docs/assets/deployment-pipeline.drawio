        <!-- Cost box -->
        <mxCell id="cost_box" value="&lt;b&gt;Cost Estimate&lt;/b&gt;&lt;br&gt;&lt;br&gt;ml.g4dn.xlarge: ~$0.74/hr&lt;br&gt;Fargate (0.5vCPU/1GB): ~$0.03/hr&lt;br&gt;API Gateway: pay per request&lt;br&gt;&lt;b&gt;Total: ~$0.80/hr&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;fontColor=#E65100;fontSize=12;verticalAlign=middle;align=left;spacingLeft=15;" vertex="1" parent="1">

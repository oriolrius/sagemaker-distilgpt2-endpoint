        <mxCell id="bar_sm" value="SageMaker Endpoint: Creating → InService" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0D47A1;strokeColor=#002171;fontColor=#FFFFFF;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="150" y="555" width="700" height="35" as="geometry"/>
